generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model mealx {
  id           Int             @id @default(autoincrement())
  datex        DateTime
  details      Json
  totalRowId   Int?            @unique
  namex        String
  totalrowmeal totalRow_table?

  @@map("meal")
}

model totalRow_table {
  id          Int   @id @default(autoincrement())
  caloriesTot Float
  carbTot     Float
  fatTot      Float
  fiberTot    Float
  portionTot  Float @default(0)
  proteinTot  Float
  mealId      Int   @unique
  meal        mealx @relation(fields: [mealId], references: [id])

  @@map("totalrowmeal")
}

model recipe_table {
  id             Int                   @id @default(autoincrement())
  details        Json
  totalRowId     Int?                  @unique
  namex          String
  totalrowrecipe recipeTotalRow_table?

  @@map("recipe")
}

model recipeTotalRow_table {
  id          Int          @id @default(autoincrement())
  caloriesTot Float
  carbTot     Float
  fatTot      Float
  fiberTot    Float
  portionTot  Float        @default(0)
  proteinTot  Float
  recipexId   Int          @unique
  recipe      recipe_table @relation(fields: [recipexId], references: [id])

  @@map("totalrowrecipe")
}
