generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model mealTable {
  id     Int             @id @default(autoincrement())
  name   String
  items  Json
  datex  DateTime
  totals totalRowTable[]
  @@map("meal")
}

model totalRowTable {
  id          Int       @id @default(autoincrement())
  mealId      Int
  caloriesTot Float
  carbTot     Float
  fatTot      Float
  proteinTot  Float
  fiberTot    Float
  portionTot  Float     @default(0)
  datex       DateTime
  meal        mealTable @relation(fields: [mealId], references: [id])

  @@index([mealId], map: "totalrow_mealId_fkey")
  @@map("totalrow")
}


model recipeTable {
  id     Int             @id @default(autoincrement())
  name   String
  items  Json
  totals totalRowTableRecipe[]
  @@map("recipe")
}

model totalRowTableRecipe {
  id          Int       @id @default(autoincrement())
  recipeId      Int
  caloriesTot Float
  carbTot     Float
  fatTot      Float
  proteinTot  Float
  fiberTot    Float
  portionTot  Float     @default(0)
  recipe        recipeTable @relation(fields: [recipeId], references: [id])

  @@index([recipeId], map: "totalRowTableRecipeId_fkey")
  @@map("totalrowRecipe")
}