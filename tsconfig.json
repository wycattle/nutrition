//tsconfig.json


//These settings are optimized for a Next.js React project:

{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {       
      "@/styles/*": [ //Path aliases under "paths" let you use @/styles/* instead of ../styles/*
        "styles/*"
      ],
      "@/types/*": [
        "types/*"
      ]
      // Add other path aliases as needed
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "commonJS",
    "outDir": "out",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",    //Keeps JSX as-is for Next.js to handle
    "incremental": true,
    "target": "ES6",    //Compiles to ES6 instead of older ES3/ES5 default
    "sourceMap": true,

    "plugins": [    // integrates Next.js TypeScript plugin
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.js"
  ]
}
