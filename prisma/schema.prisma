// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Meal {
  id     Int     @id @default(autoincrement())
  name   String
  date   DateTime
  items  Json
  totals Totalrow[] // one-to-many relation
}

model Totalrow {
  id          Int     @id @default(autoincrement())
  mealId      Int
  portionTot  Float   @default(0)
  caloriesTot Float
  carbTot     Float
  fatTot      Float
  proteinTot  Float
  fiberTot    Float
  meal        Meal    @relation(fields: [mealId], references: [id])
}
