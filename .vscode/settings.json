{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/node_modules": true,
        "node_modules": true,
        "**/postcss.config.js": true,
        "**/next.config.mjs": false,
        "next.config.mjs": false,
        "**/README.md": true,
        "*.md": true,
        "README.md": true,
        "**/*.md": true,
        "**/.eslintrc.json": false,
        ".eslintrc.json": false,
        "**/.next": true,
        ".next": false,
        ".vscode": false,
        "tsconfig.json": false,
        "**/package-lock.json": true,
        "package-lock.json": true,
        "next-env.d.ts": false,
        "**/.gitignore": false,
        ".gitignore": false,
        "package.json": false,
        "eslint.config.mjs": false,
        "**/*.code-workspace": true
    },
    "explorerExclude.backup": {},
    "sqltools.connections": [
    {
      "mysqlOptions": {
        "authProtocol": "default",
        "enableSsl": "Disabled"
      },
      "previewLimit": 50,
      "server": "localhost",
      "port": 3306,
      "driver": "MySQL",
      "name": "nutrition",
      "database": "nutrition",
      "username": "alanw"
    }
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true
}