//tsconfig.json
{

  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/styles/*": [
        "styles/*"
      ],
      "@/types/*": [
        "types/*"
      ]
      // Add other path aliases as needed
    },

    "allowImportingTsExtensions": true,
    
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "commonJS",
    "outDir": "out",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "target": "ES6",
    "sourceMap": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src/**/*",
    "types/**/*",
    "types/styles.d.ts",
    "styles/**/*.scss",
    "pages/**/*" 
  ],
  "exclude": [
    "node_modules",
    "**/*.js"
  ]

}