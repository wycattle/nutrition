//tsconfig.json
{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/styles/*": ["styles/*"],
      "@/types/*": ["types/*"],
      // Add other path aliases as needed
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "commonJS",
    "outDir": "out",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "target": "ES6",
    "sourceMap": true,
    "plugins": [{ "name": "next"  } ],
  },
  
  "include": [
    "src/**/*",
    "types/**/*"],

  "exclude": ["node_modules", "**/*.js"]
}