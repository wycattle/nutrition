generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model meal_table {
  id       Int   @id @default(autoincrement())
  name     String
  datex    DateTime
  desc1    String
  desc2    String
  portion  Float
  calories Float
  carb     Float
  fat      Float
  protein  Float
  GI       Float
  totalRows_link totalRow_table[]
  @@map("meal")
}

model totalRow_table {
  id          Int       @id @default(autoincrement())
  totalRowId      Int
  portionTot  Float     @default(0)
  caloriesTot Float
  carbTot     Float
  fatTot      Float
  proteinTot  Float
  fiberTot    Float
 
  meal        meal_table @relation(fields: [totalRowId], references: [id])

  @@index([totalRowId], map: "totalrowmealId_fkey")
  @@map("totalrowmeal")
}


model recipe_table {
  id       Int   @id @default(autoincrement())
  name     String
  desc1    String
  desc2    String
  portion  Float
  calories Float
  carb     Float
  fat      Float
  protein  Float
  GI       Float
  totalrow_link recipeTotalRow_table[]
  @@map("recipe")
}

model recipeTotalRow_table {
  id          Int       @id @default(autoincrement())
  recipeId      Int
  caloriesTot Float
  carbTot     Float
  fatTot      Float
  proteinTot  Float
  fiberTot    Float
  portionTot  Float     @default(0)
  recipe        recipe_table @relation(fields: [recipeId], references: [id])

  @@index([recipeId], map: "recipeTotalRow_tableId_fkey")
  @@map("totalrowrecipe")
}