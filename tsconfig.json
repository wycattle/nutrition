{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "commonJS",
    "outDir": "out",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "target": "ES6",
    "sourceMap": true,
    "plugins": [{ "name": "next"  } ],
  },
  "files": ["lib/mealDB.ts"],
  "include": [],
  "exclude": ["node_modules", "pages/_app.js"]
}